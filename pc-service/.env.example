OBS_WEBSOCKET_URL=ws://127.0.0.1:4455
OBS_WEBSOCKET_PASSWORD=
MIC_INPUT_NAME=Micro Téléphone (Couch Stream App)

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://localhost
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_CHANNEL_LOGIN=lescopaings_

# Serveur WebSocket local (Phase 1) — LAN only, protégé par un token partagé.
LOCAL_WS_PORT=8765
LOCAL_WS_TOKEN=

# Périphérique de lecture Windows où injecter l'audio micro reçu (Phase 2) —
# sous-chaîne du libellé tel qu'énuméré par node-web-audio-api.
VBCABLE_OUTPUT_DEVICE_LABEL=CABLE Input (VB-Audio Virtual Cable)

# Buffer de gigue avant lecture (ms) — plus bas = moins de latence, plus
# haut = plus de marge contre les craquements sur un Wi-Fi instable.
AUDIO_JITTER_BUFFER_MS=30
